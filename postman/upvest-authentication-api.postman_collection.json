                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "description": "(Required) The OAuth 2.0 grant type. Must be client_credentials.",
                      "key": "grant_type",
                      "value": "client_credentials"
                    },
                    {
                      "description": "(Required) The client identifier issued during onboarding.",
                      "key": "client_id",
