                    {
                      "description": "(Required) The client secret issued during onboarding.",
                      "key": "client_secret",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) A space-separated list of scopes to request.",
                      "key": "scope",
                      "value": "<string>"
