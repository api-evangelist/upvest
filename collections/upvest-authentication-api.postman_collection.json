          "request": {
            "name": "Upvest Create an access token",
            "description": {
              "content": "Obtain an OAuth 2.0 access token using client credentials. The returned opaque access token is used to authenticate subsequent API requests. You must specify the required scopes for the endpoints you intend to call.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
